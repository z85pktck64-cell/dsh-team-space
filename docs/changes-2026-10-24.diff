+```sh
+# 门禁：以前 `| tail -2` 吞掉退出码
+run_check() {
+  label=$1; shift
+  if ! "$@" > "$CHECK_LOG" 2>&1; then
+    echo "  ✗ $label 失败"; tail -30 "$CHECK_LOG"; exit 1
+  fi
+  tail -2 "$CHECK_LOG"
+}
+run_check e2e-p0 node dev/e2e-p0.mjs
+```
