+}
+
+async function call(origin, path, { method = 'GET', body, channel = 'test' } = {}) {
+  const response = await fetch(`${origin}/api/team-space/${path}`, {
+    method,
+    headers: {
+      accept: 'application/json',
+      ...(body === undefined ? {} : { 'content-type': 'application/json' }),
+      ...(channel === 'test' ? TEST : {}),
+    },
+    body: body === undefined ? undefined : JSON.stringify(body),
+    signal: AbortSignal.timeout(15_000),
+  })
+  const text = await response.text()
+  let data = null
+  try { data = text ? JSON.parse(text) : null } catch { data = { raw: text } }
+  return { status: response.status, data, text, ok: response.ok && data?.ok !== false }
+}
+
+async function upsert(origin, table, entry) {
+  const result = await call(origin, 'entry/upsert', { method: 'POST', body: { table, entry } })
+  if (!result.ok) throw new Error(`${table}/${entry.name} → HTTP ${result.status} ${result.data?.error ?? result.text.slice(0, 120)}`)
+  created.push({ table, id: result.data.entry.id })
+  return result.data.entry
+}
+
+async function cleanup() {
+  const seen = new Set()
+  for (const item of created) {
+    const key = `${item.table}:${item.id}`
+    if (seen.has(key)) continue
+    seen.add(key)
+    await call(A, 'entry/remove', { method: 'POST', body: { table: item.table, id: item.id } }).catch(() => null)
+  }
+  const list = await call(A, 'list').catch(() => null)
+  const leftovers = Object.entries(list?.data?.tables ?? {}).flatMap(([table, items]) =>
+    (items ?? []).filter(item => [item.name, item.title, item.url].filter(Boolean).join(' ').includes(STAMP)).map(item => ({ table, id: item.id })))
+  for (const item of leftovers) {
+    await call(A, 'entry/remove', { method: 'POST', body: item }).catch(() => null)
+  }
+}
+
+function assertStoreHealthy(label) {
+  let parsed = null
+  try { parsed = JSON.parse(readFileSync(STORE, 'utf8')) } catch { parsed = null }
+  ok(`${label}：store 仍是完整可解析 JSON`, Boolean(parsed))
+  const temps = readdirSync(dirname(STORE)).filter(name => name.startsWith('team-space.json.') && name.endsWith('.tmp'))
+  ok(`${label}：没有遗留半写临时文件`, temps.length === 0, temps.join(', '))
+  return parsed
+}
+
+async function j04() {
+  const aList = await call(A, 'list')
+  const bList = await call(B, 'list')
+  ok('J04 两个 DSH 进程都能读到同一份 store',
+    aList.ok && bList.ok
+      && (aList.data.tables?.skills ?? []).length === (bList.data.tables?.skills ?? []).length,
+    `A=${aList.status} B=${bList.status}`)
+
+  const rounds = 40
+  const started = Date.now()
+  const jobs = []
+  for (let index = 0; index < rounds; index += 1) {
+    for (const origin of [A, B]) {
+      jobs.push(call(origin, 'entry/upsert', {
+        method: 'POST',
+        body: {
+          table: 'todos',
+          entry: { title: `${STAMP}-race-${index}`, note: `并发写 ${index} @ ${origin}` },
+        },
+      }))
+    }
+  }
+  const results = await Promise.all(jobs)
+  for (const result of results) {
+    if (result.data?.entry?.id) created.push({ table: 'todos', id: result.data.entry.id })
+  }
+  ok('J04 两个进程并发发起 80 次写全部成功',
+    results.every(result => result.ok),
+    JSON.stringify(results.filter(result => !result.ok).slice(0, 4).map(result => ({ status: result.status, error: result.data?.error }))))
+  const after = await call(A, 'list')
+  const ids = new Set((after.data?.tables?.todos ?? []).map(item => item.id))
+  const written = results.map(result => result.data?.entry?.id).filter(Boolean)
+  const rows = written.filter(id => ids.has(id))
+  const afterB = await call(B, 'list')
+  const idsB = new Set((afterB.data?.tables?.todos ?? []).map(item => item.id))
+  let rawIds = new Set()
+  try {
+    const raw = JSON.parse(readFileSync(STORE, 'utf8'))
+    rawIds = new Set((raw.todos ?? []).map(item => item.id))
+  } catch { /* 由下一个断言报 */ }
+  const bySite = Object.fromEntries([A, B].map(origin => [origin, results
+    .filter(result => String(result.data?.entry?.note ?? '').endsWith(`@ ${origin}`))
+    .map(result => result.data?.entry?.id)
+    .filter(Boolean)
+    .filter(id => ids.has(id)).length]))
+  ok('J04 80 条并发记录一条不少（无丢失更新）', rows.length === rounds * 2,
+    JSON.stringify({ actualA: rows.length, actualB: written.filter(id => idsB.has(id)).length, raw: written.filter(id => rawIds.has(id)).length, bySite, written: written.length }))
+  ok('J04 并发写没有把 store 写坏', Boolean(assertStoreHealthy('J04')))
+  console.log(`     80 次并发写耗时 ${Date.now() - started}ms`)
+
+  if (existsSync(LOCK)) {
+    ok('J04 锁超时前置条件：跑测试前没有残留锁', false, LOCK)
+    return
+  }
+  writeFileSync(LOCK, `${process.pid}-live-holder`)
+  try {
+    const blocked = await call(A, 'entry/upsert', {
+      method: 'POST',
+    body: { table: 'todos', entry: { title: `${STAMP}-locked`, note: '应被锁拒绝' } },
+    })
+    ok('J04 有活进程持锁时写请求超时并返回明确错误',
+      blocked.status >= 400 && /另一个进程写入|稍后重试/.test(String(blocked.data?.error ?? blocked.text)),
+      `HTTP ${blocked.status} ${blocked.data?.error ?? blocked.text.slice(0, 120)}`)
+    const still = await call(A, 'list')
+    ok('J04 被锁拒绝的记录没有偷偷写入',
+      !(still.data?.tables?.todos ?? []).some(item => item.title === `${STAMP}-locked`))
+  } finally {
+    try { unlinkSync(LOCK) } catch { /* 已清理 */ }
+  }
+}
+
+async function j07() {
+  const exact = await upsert(A, 'skills', {
+    name: `${STAMP}-content-200k`,
+    description: '边界：正文恰好 200000',
+    content: 'A'.repeat(200_000),
+  })
+  const over = await upsert(B, 'skills', {
+    name: `${STAMP}-content-over`,
+    description: 'D'.repeat(2_000),
+    content: 'B'.repeat(200_001),
+  })
+  const longRepo = await upsert(A, 'repos', {
+    name: `N${STAMP}${'X'.repeat(300)}`,
+    url: `https://gitlab.txzing.com/${'x'.repeat(700)}`,
+    description: 'E'.repeat(5_000),
+    type: 'git',
+  })
+
+  const exactDetail = await call(B, `detail?table=skills&id=${encodeURIComponent(exact.id)}`)
+  const overDetail = await call(A, `detail?table=skills&id=${encodeURIComponent(over.id)}`)
+  const repoDetail = await call(B, `detail?table=repos&id=${encodeURIComponent(longRepo.id)}`)
+
+  ok('J07 正文恰好 200KB 能完整保存', exactDetail.ok && exactDetail.data.entry?.content?.length === 200_000,
+    `len=${exactDetail.data?.entry?.content?.length}`)
+  ok('J07 正文超过 200KB 按上限截断且不报 500',
+    overDetail.ok && overDetail.data.entry?.content?.length === 200_000,
+    `HTTP=${overDetail.status} len=${overDetail.data?.entry?.content?.length}`)
+  ok('J07 skill 描述 2000 → 截断到 200', overDetail.data?.entry?.description?.length === 200,
+    `len=${overDetail.data?.entry?.description?.length}`)
+  ok('J07 链接名称超长 → 截断到 120', repoDetail.data?.entry?.name?.length === 120,
+    `len=${repoDetail.data?.entry?.name?.length}`)
+  ok('J07 链接 URL 超长 → 截断到 500', repoDetail.data?.entry?.url?.length === 500,
+    `len=${repoDetail.data?.entry?.url?.length}`)
+  ok('J07 链接描述超长 → 截断到 1000', repoDetail.data?.entry?.description?.length === 1_000,
+    `len=${repoDetail.data?.entry?.description?.length}`)
+  assertStoreHealthy('J07')
+}
+
+try {
+  console.log(`\nJ04 / J07 · A=${A} B=${B} · ${STAMP}\n`)
+  await j04()
+  await j07()
+} finally {
+  await cleanup()
+  const residual = await call(A, 'list').then(result => Object.entries(result.data?.tables ?? {})
+    .flatMap(([table, items]) => (items ?? []).filter(item => [item.name, item.title, item.url].filter(Boolean).join(' ').includes(STAMP)).map(item => ({ table, name: item.name, title: item.title })))).catch(() => [])
+  ok('J04/J07 测试无残留', residual.length === 0, JSON.stringify(residual))
+  try { if (existsSync(LOCK)) unlinkSync(LOCK) } catch { /* 忽略 */ }
+}
+
+console.log(`\n结果：${checks - failures}/${checks} 通过${failures ? `，${failures} 条失败` : '，全部通过'}\n`)
+process.exit(failures ? 1 : 0)
diff --git a/dev/e2e-member.mjs b/dev/e2e-member.mjs
new file mode 100644
index 0000000..9d2aaa5
--- /dev/null
+++ b/dev/e2e-member.mjs
@@ -0,0 +1,188 @@
+#!/usr/bin/env node
+/**
+ * 成员端 / 门店端冒烟：在成员机上跑，验证「连主服务器」这条链路。
+ *
+ *   node dev/e2e-member.mjs \
+ *     --server http://<主服务器>:8080/api/team-space \
+ *     --local  http://127.0.0.1:<本机端口>/api/team-space \
+ *     --name Neo --device <客户端 deviceId>
+ *
+ * 所有写操作走 test 通道，跑完清理；不触发企微通知。
+ */
+const args = Object.fromEntries(process.argv.slice(2).map(item => {
+  const [key, ...rest] = item.replace(/^--/, '').split('=')
+  return [key, rest.join('=')]
+}))
+const SERVER = String(args.server ?? '').replace(/\/$/, '')
+const LOCAL = String(args.local ?? '').replace(/\/$/, '')
+const NAME = String(args.name ?? 'member')
+const DEVICE = String(args.device ?? '')
+const TEST = { 'x-team-space-channel': 'test' }
+
+if (!SERVER) {
+  console.error('缺少 --server')
+  process.exit(2)
+}
+
+let checks = 0
+let failures = 0
+function ok(name, cond, detail = '') {
+  checks += 1
+  if (cond) console.log(`  ✓ ${name}`)
+  else {
+    failures += 1
+    console.log(`  ✗ ${name}${detail ? ` — ${detail}` : ''}`)
+  }
+}
+
+async function req(base, path, { method = 'GET', body, headers } = {}) {
+  const merged = {
+    accept: 'application/json',
+    ...(body === undefined ? {} : { 'content-type': 'application/json' }),
+    ...(headers ?? {}),
+  }
+  const response = await fetch(`${base}/${path}`, {
+    method,
+    headers: merged,
+    body: body === undefined ? undefined : JSON.stringify(body),
+    signal: AbortSignal.timeout(8000),
+  })
+  const text = await response.text()
+  let data = null
+  try { data = text ? JSON.parse(text) : null } catch { data = { raw: text } }
+  return { status: response.status, data, text }
+}
+async function call(base, path, body, headers) {
+  const { status, data, text } = await req(base, path, { method: body === undefined ? 'GET' : 'POST', body, headers })
+  if (status < 200 || status >= 300 || data?.ok === false) {
+    throw new Error(`${path} → ${status} ${data?.error ?? text.slice(0, 80)}`)
+  }
+  return data
+}
+function versionGt(a, b) {
+  const pa = String(a).split('.').map(Number)
+  const pb = String(b).split('.').map(Number)
+  for (let i = 0; i < 3; i += 1) {
+    if ((pa[i] ?? 0) > (pb[i] ?? 0)) return true
+    if ((pa[i] ?? 0) < (pb[i] ?? 0)) return false
+  }
+  return false
+}
+
+async function main() {
+  const stamp = `mem-${Date.now().toString(36)}`
+  console.log(`\n成员端冒烟 · ${NAME} → ${SERVER}\n`)
+
+  // 1. 网络与主服务器
+  const list = await call(SERVER, 'list')
+  ok('成员能连上主服务器 /list', Boolean(list.tables))
+
+  // 2. G08：列表不返回纯本机字段
+  const firstRow = Object.values(list.tables ?? {}).flat()[0] ?? {}
+  ok('G08 /list 不含 installedLink', !('installedLink' in firstRow), Object.keys(firstRow).join(','))
+
+  // 3. 本机安装态（成员视角）
+  if (LOCAL) {
+    const local = await call(LOCAL, 'local-state?plugins=dsh-team-space')
+    const info = local.plugins?.['dsh-team-space'] ?? {}
+    ok('G07 本机识别为「已安装」', info.installed === true, JSON.stringify(info))
+    ok('G07 成员端 installedLink=false（不是发布者）', info.installedLink === false, JSON.stringify(info))
+
+    const manifest = (list.tables?.plugins ?? []).find(item => item.name === 'dsh-team-space')
+    if (manifest?.version) {
+      const installed = String(info.installedVersion ?? '')
+      const latest = String(manifest.version)
+      if (versionGt(latest, installed)) {
+        ok('I03 成员端版本低于清单 → 应提示「更新」', true, `本机 ${installed} / 清单 ${latest}`)
+      } else if (installed === latest) {
+        ok('I03 升级后版本与清单一致 → 应显示「当前插件」', true, `${installed} = ${latest}`)
+      } else {
+        ok('I03 本机版本不应高于清单（版本号可能写错）', false, `本机 ${installed} / 清单 ${latest}`)
+      }
+    } else {
+      console.log('  - 清单里没有 dsh-team-space 条目，跳过版本比较')
+    }
+  }
+
+  // 4. 主服务器建委托给成员（test 通道，不发通知）
+  const created = await call(SERVER, 'handoff/create', {
+    title: `${stamp}-handoff`,
+    brief: '成员端冒烟：认领并交回',
+    target: NAME,
+    owner: '主服务器',
+  }, TEST)
+  const handoffId = created.item?.id ?? created.id
+
+  const memberView = await call(SERVER, `list?deviceId=${encodeURIComponent(DEVICE)}&name=${encodeURIComponent(NAME)}`, undefined, TEST)
+  const strangerView = await call(SERVER, `list?deviceId=${encodeURIComponent(`${stamp}-stranger`)}&name=路人`, undefined, TEST)
+  ok('B05 指定成员能看到给自己的委托',
+    (memberView.tables?.handoffs ?? []).some(item => item.id === handoffId))
+  ok('B05 路人看不到别人的委托',
+    !(strangerView.tables?.handoffs ?? []).some(item => item.id === handoffId))
+
+  // 5. 成员认领 + 交回（真实门店端工作流）
+  await call(SERVER, 'handoff/claim', { id: handoffId, by: NAME, deviceId: DEVICE }, TEST)
+  const claimed = await call(SERVER, `detail?table=handoffs&id=${encodeURIComponent(handoffId)}`, undefined, TEST)
+  ok('B06 成员认领后状态 doing', claimed.entry?.status === 'doing', claimed.entry?.status)
+  await call(SERVER, 'handoff/complete', { id: handoffId, result: '门店端跑完', by: NAME, deviceId: DEVICE }, TEST)
+  const done = await call(SERVER, `detail?table=handoffs&id=${encodeURIComponent(handoffId)}`, undefined, TEST)
+  ok('B07 成员交回后状态 done 且 result 落库',
+    done.entry?.status === 'done' && done.entry?.result === '门店端跑完',
+    JSON.stringify({ status: done.entry?.status, result: done.entry?.result }))
+
+  // 6. 成员写入 + 通道隔离
+  const todo = await call(SERVER, 'entry/upsert', {
+    table: 'todos',
+    entry: { name: `${stamp}-todo`, description: '门店端写入' },
+  }, TEST)
+  const testList = await call(SERVER, 'list', undefined, TEST)
+  ok('成员能写入共享数据（test 通道）',
+    (testList.tables?.todos ?? []).some(item => item.id === todo.entry.id))
+  const prodList = await call(SERVER, 'list')
+  ok('F02 成员写的测试数据不污染真实列表',
+    !(prodList.tables?.todos ?? []).some(item => item.id === todo.entry.id))
+
+  // 7. MCP（成员零安装接入）
+  const mcpTools = await req(SERVER, 'mcp', {
+    method: 'POST',
+    body: { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} },
+  })
+  ok('成员端 MCP 暴露 9 个工具',
+    (mcpTools.data?.result?.tools ?? []).length === 9,
+    String((mcpTools.data?.result?.tools ?? []).length))
+  const mcpSkills = await req(SERVER, 'mcp', {
+    method: 'POST',
+    body: { jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'team_space_list_skills', arguments: {} } },
+    headers: TEST,
+  })
+  ok('成员端 MCP 能读技能列表', !mcpSkills.data?.result?.isError)
+
+  // 8. 门户与下载
+  const portal = await req(SERVER, 'portal')
+  ok('成员能打开团队空间门户', portal.status === 200 && /<html/i.test(portal.text))
+  const guide = await req(SERVER, 'guide')
+  ok('成员能打开新手引导', guide.status === 200 && /<html/i.test(guide.text))
+  const manifestVersion = (list.tables?.plugins ?? []).find(item => item.name === 'dsh-team-space')?.version
+  if (manifestVersion) {
+    const download = await req(SERVER, `download?file=${encodeURIComponent(`dsh-team-space-${manifestVersion}.tgz`)}`)
+    ok('I02 成员能下载清单里的安装包', download.status === 200, `HTTP ${download.status}`)
+  }
+
+  // 9. 清理
+  await call(SERVER, 'entry/remove', { table: 'todos', id: todo.entry.id }, TEST)
+  const gw = await call(SERVER, 'gateway-status')
+  await call(SERVER, 'handoff/remove', { id: handoffId, deviceId: gw.deviceId }, TEST)
+  const residual = await call(SERVER, 'list', undefined, TEST)
+  const leftoverTodos = (residual.tables?.todos ?? []).filter(item => String(item.name ?? '').startsWith(stamp))
+  const leftoverHandoffs = (residual.tables?.handoffs ?? []).filter(item => String(item.title ?? '').startsWith(stamp))
+  ok('成员端测试无残留', leftoverTodos.length === 0 && leftoverHandoffs.length === 0,
+    `todos=${leftoverTodos.length} handoffs=${leftoverHandoffs.length}`)
+
+  console.log(`\n结果：${checks - failures}/${checks} 通过${failures ? `，${failures} 条失败` : '，全部通过'}\n`)
+  process.exit(failures ? 1 : 0)
+}
+
+main().catch(error => {
+  console.error('\n成员端冒烟中断：', error.message, '\n')
+  process.exit(1)
+})
diff --git a/dev/e2e-offline.cjs b/dev/e2e-offline.cjs
new file mode 100644
index 0000000..5c252b6
--- /dev/null
+++ b/dev/e2e-offline.cjs
@@ -0,0 +1,187 @@
+#!/usr/bin/env node
+/**
+ * J08：客户端断网。
+ *
+ * 在真实浏览器里分别中断「认领委托」与「确认分享」请求，验证：
+ * - 有明确失败提示；
+ * - 页面不白屏；
+ * - 服务端状态没有被静默改掉。
+ *
+ * 依赖 Playwright：
+ *   NODE_PATH="$PWD/node_modules" node dev/e2e-offline.cjs \
+ *     --url=http://127.0.0.1:<port>/?token=...
+ */
+const { chromium } = require('playwright')
+const { join, resolve } = require('node:path')
+const { mkdirSync } = require('node:fs')
+
+const arg = name => process.argv.find(item => item.startsWith(`--${name}=`))?.slice(name.length + 3) ?? ''
+const URL_ARG = arg('url')
+const SHOTS = resolve(arg('shots') || join(__dirname, '..', 'docs', 'images'))
+if (!URL_ARG) {
+  console.error('用法：node dev/e2e-offline.cjs --url=http://127.0.0.1:<port>/?token=...')
+  process.exit(2)
+}
+
+const parsed = new URL(URL_ARG)
+const API = `${parsed.origin}/api/team-space`
+const STAMP = `offline-${Date.now().toString(36)}`
+const TEST = { 'x-team-space-channel': 'test', accept: 'application/json' }
+const handoffIds = []
+let checks = 0
+let failures = 0
+
+function ok(name, cond, detail = '') {
+  checks += 1
+  console.log(`${cond ? '  ✓' : '  ✗'} ${name}${cond ? '' : ` — ${detail}`}`)
+  if (!cond) failures += 1
+}
+
+async function api(path, { method = 'GET', body } = {}) {
+  const response = await fetch(`${API}/${path}`, {
+    method,
+    headers: {
+      ...TEST,
+      ...(body === undefined ? {} : { 'content-type': 'application/json' }),
+    },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  })
+  const text = await response.text()
+  let data = null
+  try { data = text ? JSON.parse(text) : null } catch { data = { raw: text } }
+  if (!response.ok || data?.ok === false) {
+    throw new Error(`${path} → HTTP ${response.status} ${data?.error ?? text.slice(0, 160)}`)
+  }
+  return data
+}
+
+async function cleanup() {
+  let deviceId = ''
+  try { deviceId = (await api('gateway-status')).deviceId ?? '' } catch { /* 忽略 */ }
+  for (const id of handoffIds) {
+    await api('handoff/remove', { method: 'POST', body: { id, deviceId } }).catch(() => null)
+  }
+}
+
+async function gotoApp(page) {
+  await page.goto(URL_ARG, { waitUntil: 'domcontentloaded', timeout: 30_000 })
+  await page.waitForTimeout(1800)
+  await page.evaluate(() => {
+    localStorage.setItem('team-space:name', 'Xinzhan')
+    localStorage.setItem('team-space:channel', 'test')
+  })
+  await page.reload({ waitUntil: 'domcontentloaded' })
+  await page.waitForTimeout(1800)
+}
+
+async function openTeam(page) {
+  await page.locator('.ts-nav-text').click()
+  await page.locator('.ts-root').waitFor({ state: 'visible', timeout: 10_000 })
+  await page.waitForTimeout(500)
+}
+
+async function clickTab(page, label) {
+  await page.locator('.ts-tab').filter({ hasText: label }).click()
+  await page.waitForTimeout(350)
+}
+
+async function main() {
+  mkdirSync(SHOTS, { recursive: true })
+  console.log(`\nJ08 客户端断网 · ${parsed.origin} · ${STAMP}\n`)
+
+  const handoff = await api('handoff/create', {
